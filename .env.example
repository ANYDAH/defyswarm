# Optional Groq credential for generating adaptive canaries.
GROQ_API_KEY=

# Optional fixed secret for webhook and CLI ingestion. Omit to generate one at startup.
DEFYSWARM_INGEST_TOKEN=

# Optional S3-compatible monitor and vault credential pairs.
# Configure the endpoint and buckets in Setup & Settings.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_VAULT_ACCESS_KEY_ID=
S3_VAULT_SECRET_ACCESS_KEY=
